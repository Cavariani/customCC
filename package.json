{
  "name": "customcc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "start": "node bin/customcc.mjs"
  },
  "dependencies": {
    "@fontsource/doto": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.41.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "bin": {
    "customcc": "bin/customcc.mjs"
  }
}
